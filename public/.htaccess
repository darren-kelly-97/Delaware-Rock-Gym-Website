# The Delaware Rock Gym: Apache config for the static Next.js export.
# Upload the contents of /out to the web root.

DirectoryIndex index.html
ErrorDocument 404 /404.html
Options -MultiViews

<IfModule mod_rewrite.c>
RewriteEngine On

# One canonical host: https://www.derockgym.com
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} !^www\. [NC]
RewriteRule ^ https://www.derockgym.com%{REQUEST_URI} [R=301,L]

# Legacy .php URLs -> new clean URLs (301, permanent). Anchors (#Intro, #Classes...) carry over in the browser.
RewriteRule ^index\.php$            /                     [R=301,L,NC]
RewriteRule ^newto\.php$            /new-to-climbing/     [R=301,L,NC]
RewriteRule ^overview\.php$         /climbing-overview/   [R=301,L,NC]
RewriteRule ^FAQ\.php$              /faq/                 [R=301,L,NC]
RewriteRule ^pricing\.php$          /pricing/             [R=301,L,NC]
RewriteRule ^classes\.php$          /classes/             [R=301,L,NC]
RewriteRule ^party\.php$            /parties-and-groups/  [R=301,L,NC]
RewriteRule ^location\.php$         /directions/          [R=301,L,NC]
RewriteRule ^gal_pans\.php$         /panorama-gallery/    [R=301,L,NC]
RewriteRule ^aboutus\.php$          /about-us/            [R=301,L,NC]
RewriteRule ^contactus\.php$        /contact-us/          [R=301,L,NC]
RewriteRule ^release\.php$          /release-forms/       [R=301,L,NC]
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json image/svg+xml image/x-icon
</IfModule>
